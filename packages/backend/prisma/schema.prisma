// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             Int        @id @default(autoincrement())
  uuid           String     @unique @default(uuid())
  email          String     @unique
  nickname       String     @unique
  introduction   String     @default("등록된 소개말이 없습니다.")
  refreshToken   String?
  eventAgree     Boolean
  password       String?
  salt           String?
  provider       Provider?
  role           Role       @default(USER)
  status         UserStatus @default(ACTIVE)
  lastLogin      DateTime?
  lastPwdChanged DateTime?
  loginFailCount Int        @default(0)

  profilePhoto ProfilePhoto[]

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  join         Join[]
  photoComment PhotoComment[]
  payment      Payment[]
  myCharacter  MyCharacter?
  wallet       Wallet?
}

enum Provider {
  GOOGLE
  NAVER
  KAKAO
}

enum Role {
  ADMIN
  USER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BLOCKED
  WITHDRAWN
  OAUTH_PENDING
  CHARACTER_CHOOSE
}

model Wallet {
  id     Int @id @default(autoincrement())
  money  Int @default(1000)
  userId Int @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  user    User      @relation(fields: [userId], references: [id])
  payment Payment[]
}

model Character {
  id          Int    @id @default(autoincrement())
  name        String @unique
  description String

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  characterInfo CharacterInfo[]
  myCharacter   MyCharacter[]
}

model CharacterInfo {
  id          Int    @id @default(autoincrement())
  level       Int    @default(1)
  expNeed     Int    @default(0)
  photoUrl    String
  characterId Int

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  character Character @relation(fields: [characterId], references: [id])
}

model MyCharacter {
  id          Int @id @default(autoincrement())
  characterId Int
  userId      Int @unique

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  character Character @relation(fields: [characterId], references: [id])
  user      User      @relation(fields: [userId], references: [id])
}

model ProfilePhoto {
  id     Int    @id @default(autoincrement())
  url    String @default("base photo url - to be changed")
  userId Int

  user User @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Group {
  id          Int         @id @default(autoincrement())
  title       String
  price       Int
  description String?
  proofMethod String
  status      GroupStatus @default(OPEN)

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  groupTagMap GroupTagMap[]
  join        Join[]
  groupDate   GroupDate[]
  payment     Payment[]
}

enum GroupStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
}

model Tag {
  id   Int    @id @default(autoincrement())
  name String @unique

  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  groupTagMap GroupTagMap[]
}

model GroupTagMap {
  id      Int   @id @default(autoincrement())
  groupId Int
  tagId   Int
  group   Group @relation(fields: [groupId], references: [id])
  tag     Tag   @relation(fields: [tagId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Join {
  id       Int        @id @default(autoincrement())
  groupId  Int
  userId   Int
  status   JoinStatus @default(RESERVED)
  joinRole JoinRole

  group Group @relation(fields: [groupId], references: [id])
  user  User  @relation(fields: [userId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

enum JoinStatus {
  RESERVED
  IN_PROGRESS
  COMPLETED
}

enum JoinRole {
  HOST
  ATTENDEE
}

model GroupDate {
  id      Int    @id @default(autoincrement())
  groupId Int
  date    String /// format: YYYY-MM-DD
  group   Group  @relation(fields: [groupId], references: [id])

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  deletedAt     DateTime?
  groupProgress GroupProgress[]
}

model GroupProgress {
  id          Int                 @id @default(autoincrement())
  groupDateId Int
  status      GroupProgressStatus
  groupDate   GroupDate           @relation(fields: [groupDateId], references: [id])

  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt
  deletedAt  DateTime?
  groupPhoto GroupPhoto[]
}

enum GroupProgressStatus {
  PENDING
  COMPLETED
}

model GroupPhoto {
  id              Int           @id @default(autoincrement())
  groupProgressId Int
  url             String
  like            Int           @default(0)
  view            Int           @default(0)
  groupProgress   GroupProgress @relation(fields: [groupProgressId], references: [id])

  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  deletedAt    DateTime?
  photoComment PhotoComment[]
}

model PhotoComment {
  id           Int        @id @default(autoincrement())
  userId       Int
  groupPhotoId Int
  contents     String
  like         Int        @default(0)
  parentId     Int?
  depth        Int        @default(1) /// root=1 
  user         User       @relation(fields: [userId], references: [id])
  groupPhoto   GroupPhoto @relation(fields: [groupPhotoId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

model Payment {
  id              Int           @id @default(autoincrement())
  userId          Int
  groupId         Int
  walletId        Int?
  orderNo         String
  method          PaymentMethod
  status          PaymentStatus
  amount          Int
  refundDate      DateTime?
  refundAmount    Int?
  discountAmount  Int?
  walletMoneyPaid Int?
  totalPaid       Int
  receiptUrl      String

  user   User    @relation(fields: [userId], references: [id])
  group  Group   @relation(fields: [groupId], references: [id])
  wallet Wallet? @relation(fields: [walletId], references: [id])

  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  deletedAt      DateTime?
  paymentHistory PaymentHistory[]
}

enum PaymentMethod {
  CARD
  INJUNG_MONEY
  PHONE
}

enum PaymentStatus {
  FAIL
  IN_PROGRESS
  SUCCESS
  REFUND
}

model PaymentHistory {
  id             Int           @id @default(autoincrement())
  paymentId      Int
  previousStatus PaymentStatus /// IN_PROGRESS, SUCCESS
  currentStatus  PaymentStatus

  payment Payment @relation(fields: [paymentId], references: [id])

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}
