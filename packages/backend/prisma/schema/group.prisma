model Group {
    id          Int     @id @default(autoincrement())
    title       String
    price       Int
    description String?
    photo       String  @default("https://injunghaseyo-dev.s3.ap-northeast-2.amazonaws.com/default/group-default-image.png")

    createdAt   DateTime      @default(now())
    updatedAt   DateTime      @updatedAt
    deletedAt   DateTime?
    groupTagMap GroupTagMap[]
    join        Join[]
    groupDate   GroupDate[]
    proofMethod ProofMethod[]
}
