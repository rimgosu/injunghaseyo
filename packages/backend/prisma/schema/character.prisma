model Character {
    id          Int    @id @default(autoincrement())
    name        String @unique
    description String

    createdAt     DateTime        @default(now())
    updatedAt     DateTime        @updatedAt
    deletedAt     DateTime?
    characterInfo CharacterInfo[]
    myCharacter   MyCharacter[]
}

model MyCharacter {
    id          Int @id @default(autoincrement())
    characterId Int
    userId      Int @unique
    totalExp    Int @default(0)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    character  Character    @relation(fields: [characterId], references: [id])
    user       User         @relation(fields: [userId], references: [id])
    ExpHistory ExpHistory[]
}

model CharacterInfo {
    id          Int    @id @default(autoincrement())
    level       Int    @default(1)
    expNeed     Int    @default(0)
    photoUrl    String
    characterId Int

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    character Character @relation(fields: [characterId], references: [id])
}

model ExpHistory {
    id            Int            @id @default(autoincrement())
    myCharacterId Int
    groupId       Int? /// 모임 종료 보상 시 (END_REWARD)
    groupDateId   Int? /// 오늘의 인증 완료 시 (PROOF_REWARD)
    joinId        Int? /// 오늘의 인증 완료 시 (PROOF_REWARD)
    increasedExp  Int
    type          ExpHistoryType

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    myCharacter MyCharacter @relation(fields: [myCharacterId], references: [id])

    @@unique([groupDateId, joinId])
}

enum ExpHistoryType {
    ATTENDANCE_CHECK_REWARD
    PROOF_REWARD
    END_REWARD
}
