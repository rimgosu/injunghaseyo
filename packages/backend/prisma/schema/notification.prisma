model Notification {
    id      Int              @id @default(autoincrement())
    userId  Int
    title   String
    content String
    isRead  Boolean          @default(false)
    type    NotificationType

    moneyChange Int?
    groupId     Int?
    proofId     Int?
    commentId   Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id])
}

enum NotificationType {
    LEVEL_UP /// 캐릭터 레벨업
    DELETED_ROOM /// 방 폭파 (groupId, amount) 
    GROUP_END_REWARD /// 그룹 종료 후 리워드 지급 (groupId, amount)
    PROOF_COMMENT /// 내 인증에 댓글 달림 (proofId)
    COMMENT_REPLY /// 내 댓글에 답글 달림 (commentId)
}
