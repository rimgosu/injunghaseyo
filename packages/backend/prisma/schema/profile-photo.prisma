model ProfilePhoto {
    id     Int    @id @default(autoincrement())
    url    String @default("https://injunghaseyo-dev.s3.ap-northeast-2.amazonaws.com/default/default-profile.svg")
    userId Int

    user User @relation(fields: [userId], references: [id])

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?
}
