model Payment {
    id              Int           @id @default(autoincrement())
    orderId         Int           @unique
    orderNo         String
    method          PaymentMethod
    status          PaymentStatus
    amount          Int
    refundDate      DateTime?
    refundAmount    Int?
    discountAmount  Int?
    walletMoneyPaid Int?
    totalPaid       Int
    receiptUrl      String
    order           Order         @relation(fields: [orderId], references: [id])

    createdAt      DateTime         @default(now())
    updatedAt      DateTime         @updatedAt
    deletedAt      DateTime?
    paymentHistory PaymentHistory[]
    walletHistory  WalletHistory[]
}

enum PaymentMethod {
    CARD
    INJUNG_MONEY
    PHONE
}

enum PaymentStatus {
    FAIL
    IN_PROGRESS
    SUCCESS
    REFUND
}
