model GroupTagMap {
    id      Int   @id @default(autoincrement())
    groupId Int
    tagId   Int
    group   Group @relation(fields: [groupId], references: [id])
    tag     Tag   @relation(fields: [tagId], references: [id])

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?
}
