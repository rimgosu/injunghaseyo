model GroupPhoto {
    id              Int           @id @default(autoincrement())
    groupProgressId Int
    url             String
    like            Int           @default(0)
    view            Int           @default(0)
    groupProgress   GroupProgress @relation(fields: [groupProgressId], references: [id])

    createdAt    DateTime       @default(now())
    updatedAt    DateTime       @updatedAt
    deletedAt    DateTime?
    photoComment PhotoComment[]
}
