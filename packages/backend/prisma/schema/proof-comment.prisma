model ProofComment {
    id                 Int                  @id @default(autoincrement())
    userId             Int
    proofId            Int
    contents           String
    parentId           Int?
    user               User                 @relation(fields: [userId], references: [id])
    proof              Proof                @relation(fields: [proofId], references: [id])
    commentInteraction CommentInteraction[]

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    replies ProofComment[] @relation("CommentReplies")
    parent  ProofComment?  @relation("CommentReplies", fields: [parentId], references: [id])
}
