model PhotoComment {
    id           Int        @id @default(autoincrement())
    userId       Int
    groupPhotoId Int
    contents     String
    like         Int        @default(0)
    parentId     Int?
    depth        Int        @default(1) /// root=1 
    user         User       @relation(fields: [userId], references: [id])
    groupPhoto   GroupPhoto @relation(fields: [groupPhotoId], references: [id])

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?
}
