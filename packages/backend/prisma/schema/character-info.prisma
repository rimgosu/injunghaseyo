model CharacterInfo {
    id          Int    @id @default(autoincrement())
    level       Int    @default(1)
    expNeed     Int    @default(0)
    photoUrl    String
    characterId Int

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    character Character @relation(fields: [characterId], references: [id])
}
