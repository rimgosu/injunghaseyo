model GroupProgress {
    id          Int                 @id @default(autoincrement())
    groupDateId Int
    joinId      Int
    status      GroupProgressStatus
    groupDate   GroupDate           @relation(fields: [groupDateId], references: [id])
    join        Join                @relation(fields: [joinId], references: [id])

    createdAt  DateTime    @default(now())
    updatedAt  DateTime    @updatedAt
    deletedAt  DateTime?
    proofPhoto ProofPhoto?
}

enum GroupProgressStatus {
    PENDING
    COMPLETED
}
