model Proof {
    id              Int           @id @default(autoincrement())
    groupProgressId Int           @unique
    like            Int           @default(0)
    view            Int           @default(0)
    groupProgress   GroupProgress @relation(fields: [groupProgressId], references: [id])

    createdAt        DateTime           @default(now())
    updatedAt        DateTime           @updatedAt
    deletedAt        DateTime?
    photoComment     PhotoComment[]
    PhotoProof       PhotoProof[]
    ButtonClickProof ButtonClickProof[]
    LocationProof    LocationProof[]
}

model PhotoProof {
    id      Int    @id @default(autoincrement())
    proofId Int
    url     String /// s3 photo url
    proof   Proof  @relation(fields: [proofId], references: [id])

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?
}

model ButtonClickProof {
    id      Int   @id @default(autoincrement())
    proofId Int
    proof   Proof @relation(fields: [proofId], references: [id])

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?
}

model LocationProof {
    id        Int   @id @default(autoincrement())
    proofId   Int
    latitude  Float
    longitude Float
    proof     Proof @relation(fields: [proofId], references: [id])

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?
}
