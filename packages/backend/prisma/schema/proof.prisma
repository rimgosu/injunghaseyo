model Proof {
    id              Int           @id @default(autoincrement())
    groupProgressId Int           @unique
    view            Int           @default(0)
    groupProgress   GroupProgress @relation(fields: [groupProgressId], references: [id])

    photoProof       PhotoProof?
    buttonClickProof ButtonClickProof?
    locationProof    LocationProof?
    proofInteraction ProofInteraction[]
    proofReport      ProofReport[]
    createdAt        DateTime           @default(now())
    updatedAt        DateTime           @updatedAt
    deletedAt        DateTime?
    photoComment     ProofComment[]
}

model PhotoProof {
    id      Int    @id @default(autoincrement())
    proofId Int    @unique
    url     String /// s3 photo url
    proof   Proof  @relation(fields: [proofId], references: [id])

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?
}

model ButtonClickProof {
    id      Int   @id @default(autoincrement())
    proofId Int   @unique
    proof   Proof @relation(fields: [proofId], references: [id])

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?
}

model LocationProof {
    id        Int   @id @default(autoincrement())
    proofId   Int   @unique
    latitude  Float
    longitude Float
    proof     Proof @relation(fields: [proofId], references: [id])

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?
}
