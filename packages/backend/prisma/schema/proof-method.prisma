model ProofMethod {
    id       Int       @id @default(autoincrement())
    groupId  Int
    contents String
    type     ProofType
    fromMin  Int       @default(0) /// 인증 시작 시간 (분 단위)
    toMin    Int       @default(1440) /// 인증 종료 시간 (분 단위)

    createdAt DateTime  @default(now())
    updatedAt DateTime  @updatedAt
    deletedAt DateTime?

    group Group @relation(fields: [groupId], references: [id])

    groupProgress GroupProgress[]
}

enum ProofType {
    UPLOAD_PHOTO
    CLICK_BUTTON
    CHECK_LOCATION
}
