{
  "name": "monorepo",
  "private": true,
  "workspaces": {
    "packages": [
      "packages/backend",
      "packages/frontend"
    ]
  },
  "scripts": {
    "start:frontend": "yarn workspace @monorepo/frontend start",
    "start:backend": "yarn workspace @monorepo/backend start:dev",
    "dev": "concurrently \"yarn start:frontend\" \"yarn start:backend\"",
    "build": "yarn workspaces run build",
    "test": "yarn workspaces run test",
    "db": "docker compose -f docker-compose.db.yaml up -d",
    "prisma:setting": "yarn workspace @monorepo/backend prisma:migrate:dev && yarn workspace @monorepo/backend prisma:seed",
    "gen:sdk": "yarn workspace @monorepo/backend gen:swagger && yarn workspace @monorepo/backend gen:sdk && cp ./packages/backend/sdk/injunghaseyo-api.ts ./packages/libs/src"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "version": "1.0.0",
  "main": "index.js",
  "repository": "git@github.com:rimgosu/injunghaseyo.git",
  "author": "ji-hyup <newnyup@gmail.com>",
  "license": "MIT"
}